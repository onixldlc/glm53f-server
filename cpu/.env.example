# CPU-only stack. No GPU, no CUDA — weights run on the host cores.
#
# A 320B MoE is a stranger case than a dense 27B was. Only 18B of parameters are
# active per token, so the arithmetic per token is roughly comparable to a 18B
# dense model — but every one of the 320B has to be resident, because the router
# can reach any expert on any token. So this trades "needs a huge GPU" for
# "needs a huge amount of RAM", and it is still bound by RAM bandwidth rather
# than clock speed: faster memory beats more cores.
#
# No card to measure, so the VRAM autoscaler stays off.
AUTO_SCALE=0

N_GPU_LAYERS=0

# Hard ceiling on CPU *usage*, as a fraction of the whole box.
# CFS quota: 3.0 = three cores' worth of time per period = 50% of 6 vCPU.
# 4 vCPU box -> 2.0, 8 vCPU box -> 4.0.
CPU_LIMIT=3.0
# 112.1 GiB of weights + ~0.4 GiB f16 KV at 32768 + overhead. This is the real
# cost of the model and there is no way to shrink it except a smaller quant:
#   UD-IQ2_XXS 94.85 GiB -> MEM_LIMIT=104g    UD-IQ1_S 86.69 GiB -> 96g
MEM_LIMIT=124g

# Keep THREADS equal to CPU_LIMIT. More threads than the quota allows does not
# go faster — they just take turns being frozen when the quota runs out, which
# costs cache locality and adds latency.
THREADS=3
THREADS_BATCH=3

# Shard 1 of the quant; the entrypoint reads "-of-0000N" off the name and fetches
# the rest into the same directory, which is where llama.cpp looks for them.
MODEL_FILE=UD-IQ3_XXS/GLM-5.3-Flash-UD-IQ3_XXS-00001-of-00004.gguf

# Vision costs 1.08 GB and is slow without a GPU. Flip to 1 if you need images.
ENABLE_VISION=0

# Kept modest on purpose: prompt processing on CPU is what makes a long context
# painful, not the RAM it costs — and on this model the RAM really is cheap, at
# ~13 MiB of f16 KV per 1024 tokens.
#
# 'auto' is for a GPU, not here: llama.cpp's fitter sizes the KV pool against
# free DEVICE memory, which on a CPU build is not the thing you are rationing.
# Pick a number and keep MEM_LIMIT above it.
CTX_SIZE=32768

# Flash attention is a CPU win too. No --cache-type-k/v override below: f16 is
# the llama.cpp default and only 11 of 45 layers hold a per-token cache, so
# there is nothing worth reclaiming by going to q8_0.
FLASH_ATTN=on

# Sampler preset is Z.ai's DeepSWE recommendation (temp 0.95, top-p 1.0), the one
# meant for code and analysis rather than their general default of temp 1.0 /
# top-p 0.95.
#
# --reasoning-effort is 'low' here and not 'high' as on the GPU stack: thinking
# tokens are decoded one at a time, so on CPU they are the single most expensive
# thing you can ask for.
#
# --tools resolve relative paths against the server's working directory,
# /workspace — which is the uploads volume, so anything dropped at /manage/ is
# readable by these tools as-is. exec_shell_command is deliberately left out;
# the uploads_* MCP tools cover unpacking archives.
EXTRA_ARGS=--temp 0.95 --top-p 1.0 --reasoning-effort low --tools read_file,write_file,edit_file,file_glob_search,grep_search,get_info

# A sharded quant is 4 files of up to 50 GB each, so this matters more here than
# it did on a single-file 18 GB download.
DOWNLOAD_ATTEMPTS=20

# --- MCP tool servers -------------------------------------------------------
# Master switch. 0 means no MCP config is passed at all, whatever the two
# per-server switches say. Both servers are stdio children of llama-server:
# this llama.cpp release parses only command/args/env in its MCP config, so
# there is no HTTP transport and nothing to point at another container.
MCP_ENABLE=1

# uploads_list / uploads_peek / uploads_extract / uploads_tree / uploads_stat.
# These exist so the model is told WHAT was uploaded and WHERE it landed — the
# built-in read_file can already open it, but only once it knows the path. Every
# path these return is relative to /workspace, ready for read_file as-is.
MCP_FILES_ENABLE=1

# web_search / web_fetch. Off by default here: uploads are the common case and
# this one reaches the internet.
MCP_WEB_ENABLE=0

# Caps on one tool call's output, so an extracted node_modules cannot flood the
# context window.
UPLOADS_MAX_DEPTH=12
UPLOADS_MAX_ENTRIES=400

# --- Gateway (nginx + njs) --------------------------------------------------
# Empty disables the upload token entirely, which is the default: reaching the
# port already means an SSH tunnel, so a second secret buys little. Set it and
# uploads need X-Upload-Token (the /manage/ page has a field for it).
UPLOAD_TOKEN=

# Largest single upload nginx will accept. 0 = no limit.
MAX_UPLOAD_SIZE=8g

# --- Web search backend -----------------------------------------------------
# Only read when MCP_WEB_ENABLE=1. Empty = DuckDuckGo lite endpoint, no key and
# no account. Point at your own SearXNG to keep queries on your network (needs
# `json` in its search.formats).
SEARXNG_URL=
SEARCH_RESULTS=8
FETCH_MAX_CHARS=20000
HTTP_TIMEOUT=20
