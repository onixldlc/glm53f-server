# AUTO_SCALE=1 reads the host's VRAM at start and picks MODEL_FILE, CTX_SIZE and
# the KV cache type for you, so one template works on any host:
#
# 131072 context is a FLOOR, not a target — it never shrinks. The QUANT is what
# flexes: autoscale.sh walks the quants largest-first and takes the first that
# holds 128K, trying f16 KV and then q8_0 on each one.
#
# Minimum VRAM per quant, as weights + 128K of KV + the 1110 MiB mmproj:
#
#               q8_0 /   f16 KV                      q8_0 /   f16 KV
#   UD-Q6_K_XL  283776 / 287616 MiB      UD-Q5_K_XL  234636 / 238476 MiB
#   UD-Q4_K_XL  195918 / 199758 MiB      UD-IQ4_XS   155019 / 158859 MiB
#   UD-Q3_K_XL  146163 / 150003 MiB      UD-IQ3_XXS  120253 / 124093 MiB
#   UD-Q2_K_XL  109146 / 112986 MiB      UD-IQ2_XXS  102589 / 106429 MiB
#   UD-IQ1_M     98521 / 102361 MiB      UD-IQ1_S     94237 /  98077 MiB
#
# PLUS 4096 MiB PER GPU (FIT_MARGIN_MIB), not 4096 in total. llama.cpp splits
# LAYERS across devices, so every card needs its own headroom for compute
# buffers: 8192 MiB of a 2-card host is unusable, 16384 of a 4-card one. Treat
# that reserve as a total and the load dies AFTER the weights are resident,
# which is a long way to go to find out.
#
# The 1110 MiB vision tower is per-device too, in a different way: the layers
# split evenly but the mmproj goes on DEVICE 0 ALONE, so device 0 is the card
# that runs out first. autoscale.sh charges it N times and reports device 0
# separately — "free ~5338 MiB per device, 4228 MiB on device 0".
#
# KV costs 64 MiB per 1024 tokens at f16 and 34 MiB at q8_0 — the same measured
# numbers the qwen image used. autoscale.sh takes the biggest quant that holds
# 128K with q8_0 KV, then upgrades that row to f16 if f16 also fits. A bigger
# quant at q8_0 beats a smaller one at f16: the KV type costs far less quality
# than a whole quant step.
#
# What autoscale.sh actually picks, per host (free MiB is on DEVICE 0):
#   4x RTX 5090   130428 MiB -> UD-Q2_K_XL @ q8_0    4488 MiB free on dev 0
#   1x H200-141   144384 MiB -> UD-IQ3_XXS @ f16    20291
#   2x A100-80    163840 MiB -> UD-Q3_K_XL @ f16     6364
#   8x RTX 4090   196608 MiB -> UD-IQ4_XS  @ q8_0    4228
#   8x RTX 5090   260856 MiB -> UD-Q4_K_XL @ f16     6666
#   2x H200-141   288768 MiB -> UD-Q5_K_XL @ f16    24591
#   4x A100-80    327680 MiB -> UD-Q6_K_XL @ f16     9184
#
# 3x RTX 5090 (97821 MiB) holds nothing at 128K once each card keeps its
# reserve, and autoscale.sh says so loudly instead of shrinking your context.
#
# THE DISK IS A BUDGET TOO. Quants are quoted in GiB, disks are sold in GB, and
# the 1.074 between them is enough to kill a rented box: UD-IQ4_XS is 146.05 GiB
# = 156.8 GB, so a 150 GB container disk cannot hold it, and a filesystem that
# fills up stops everything that writes — sshd included. autoscale.sh reads df
# at MODEL_DIR, keeps DISK_RESERVE_MIB free, steps the quant down to fit, and
# refuses to start at all if nothing fits. Container disk to ask for:
#   UD-Q6_K_XL 320 GB   UD-Q5_K_XL 270 GB   UD-Q4_K_XL 230 GB
#   UD-IQ4_XS  200 GB   UD-Q3_K_XL 170 GB   UD-IQ3_XXS 150 GB
#   UD-Q2_K_XL 130 GB   UD-IQ2_XXS 130 GB   UD-IQ1_M/S 120 GB
#
# If a pick is still too optimistic, the entrypoint does not strand you: when
# llama-server dies early it retries on the SAME weights with q8_0 KV, then half
# the context, then a quarter. Nothing is re-downloaded.
#
# Set AUTO_SCALE=0 to pin MODEL_FILE and CTX_SIZE below instead.
#
# PIN THE QUANT, AUTO-SIZE THE CONTEXT. These two compose, and the combination is
# usually what you want on a host the table under-fills: AUTO_SCALE=0 means
# autoscale.sh never runs, so nothing can overwrite your MODEL_FILE, and
# CTX_SIZE=auto hands only the context to llama.cpp's own fitter, which measures
# free VRAM per device instead of estimating it from a table.
#
#   AUTO_SCALE=0
#   MODEL_FILE=UD-IQ3_XXS/GLM-5.3-Flash-UD-IQ3_XXS-00001-of-00004.gguf
#   CTX_SIZE=auto
#
# Keep --cache-type-k/v in EXTRA_ARGS if the table above shows your host needs
# q8_0: at AUTO_SCALE=0 nothing picks the KV type for you and llama.cpp defaults
# to f16, which costs 3840 MiB more at 128K. Note that N_GPU_LAYERS is passed
# explicitly, and the fitter only
# adjusts arguments that are NOT passed, so it will shrink the context but never
# spill layers to CPU. Pin a quant whose weights actually fit.
#
# MODEL_FILE always names shard 1. The entrypoint reads the "-of-0000N" suffix
# off the filename and fetches the remaining shards into the same directory,
# which is where llama.cpp looks for them. Nothing else to configure.
AUTO_SCALE=1

# Only read when AUTO_SCALE=0. 112.10 GiB over 4 shards, the best fit for 128 GB.
# UD-IQ4_XS = 146.05 GiB for 160 GB. UD-Q2_K_XL = 101.25 GiB for 112 GB.
# Measured quality, perplexity vs BF16 / same-top-p agreement:
#   UD-IQ3_XXS 1.341x / 81.8%    UD-Q2_K_XL - / 78%    UD-IQ2_XXS 1.883x / 73.2%
# The IQ2 -> IQ3 step halves KL divergence, so 128 GB is the lowest tier worth
# trusting for agentic work.
MODEL_FILE=UD-IQ3_XXS/GLM-5.3-Flash-UD-IQ3_XXS-00001-of-00004.gguf

# Vision tower (+1.08 GB). GLM-5.3-Flash is natively multimodal, so this is a
# real capability rather than a bolt-on. 0 = text only.
ENABLE_VISION=1

# Only read when AUTO_SCALE=0. A number, or 'auto' to drop --ctx-size entirely
# and let llama.cpp's own fitter size the KV pool against free VRAM (it is on by
# default and measures compute buffers instead of estimating them).
# The model tops out at 1048576, but that is 64 GiB of f16 KV; 131072 costs
# 8192 MiB at f16 or 4352 at q8_0. CTX_TARGET sets the floor autoscale.sh sizes
# the quant around — raise it and the whole table shifts down a tier or two.
CTX_SIZE=131072

# Headroom left free on each device, MiB. 4x llama.cpp's stock 1024, because 320B
# of MoE weights needs far more per-device scratch than a 27B dense model did.
# autoscale.sh assumes this same number when it sizes the context.
FIT_MARGIN_MIB=4096

# Free space to leave on the weights filesystem, MiB. A quant is sized to fit
# the disk as well as the cards; with less than this left over, autoscale.sh
# steps down a quant rather than filling the volume.
DISK_RESERVE_MIB=8192

# Connections per file. HF's CDN shapes per connection, so one stream tops out
# around 50-200 MB/s however fat the link is — on a 7 Gbit/s host that is the
# difference between 5 minutes and half an hour of billed GPU time. aria2 is in
# the image for this; 1 forces the single-stream curl path.
DOWNLOAD_CONNS=16

# Seconds between download progress lines (size, rate, ETA for the file and for
# the whole job). 0 silences them.
PROGRESS_INTERVAL=30

N_GPU_LAYERS=99
FLASH_ATTN=on

# Sampler preset is Z.ai's DeepSWE recommendation (temp 0.95, top-p 1.0), the one
# meant for code and analysis rather than their general default of temp 1.0 /
# top-p 0.95. No top-k or min-p: the model card does not specify them.
#
# --reasoning-effort maps onto the model's thinking modes. The template default
# is 'max'; 'high' is set here because reviewers running it through OpenCode
# reported long traces and needing to nudge it along with continuations, and
# 'high' buys tokens back without dropping to 'low'. The flag parses
# default/minimal/low/medium/high/xhigh/max (common/arg.cpp:3718), but this model
# only documents low, high and max.
#
# --tools hands the model llama.cpp's built-in agent tools. They resolve relative
# paths against the server's working directory, /workspace — which is the uploads
# volume, so anything dropped at /manage/ is readable by these tools as-is.
# exec_shell_command is deliberately left out; the uploads_* MCP tools below
# cover unpacking archives, which is what it would otherwise be needed for.
#
# No --cache-type-k/v here: at AUTO_SCALE=1 autoscale.sh passes the KV type it
# chose. Pin it yourself only at AUTO_SCALE=0, and only if your host is in the
# q8_0 column of the table at the top.
#
# The model also ships an MTP (multi-token prediction) head for speculative
# decoding; llama.cpp drives it through --spec-type / --spec-draft-n-max, and the
# model card suggests stopping at about 2 draft tokens. Left off here because it
# needs a second weights file this image does not fetch.
EXTRA_ARGS=--temp 0.95 --top-p 1.0 --reasoning-effort high --tools read_file,write_file,edit_file,file_glob_search,grep_search,get_info

# Retries per file before giving up (each resumes, it never restarts from 0).
# A sharded quant is 3-7 files of up to 50 GB each, so this matters more here
# than it did on a single-file 18 GB download.
DOWNLOAD_ATTEMPTS=20

# Optional: only raises HF rate limits, not required for this public repo.
# HF_TOKEN=

# --- built-in tools ---------------------------------------------------------
# llama.cpp's --tools. Its own default is NO tools, so without this the model
# gets MCP's search and upload listing but cannot read, write or edit a file in
# the workspace below — which is what the workspace is for.
#
# Available: read_file, file_glob_search, grep_search, exec_shell_command,
# write_file, edit_file, get_info. "all" enables every one of them.
#
# "all" is the default here, and it includes exec_shell_command: that runs
# commands on this host, and anything that reaches the chat endpoint can call
# it. Keep the port private, or drop to a comma list without it.
#
# Enabling any tool makes llama.cpp clamp --cors-origins to localhost.
TOOLS=all

# --- MCP tool servers -------------------------------------------------------
# Master switch. 0 means no MCP config is passed at all, whatever the two
# per-server switches say. Both servers are stdio children of llama-server:
# this llama.cpp release parses only command/args/env in its MCP config, so
# there is no HTTP transport and nothing to point at another container.
MCP_ENABLE=1

# uploads_list / uploads_peek / uploads_extract / uploads_tree / uploads_stat.
# These exist so the model is told WHAT was uploaded and WHERE it landed — the
# built-in read_file can already open it, but only once it knows the path. Every
# path these return is relative to /workspace, ready for read_file as-is.
MCP_FILES_ENABLE=1

# web_search / web_fetch. Off by default here: uploads are the common case and
# this one reaches the internet.
MCP_WEB_ENABLE=0

# Caps on one tool call's output, so an extracted node_modules cannot flood the
# context window.
UPLOADS_MAX_DEPTH=12
UPLOADS_MAX_ENTRIES=400

# How long to wait for nginx to actually ANSWER on LISTEN_PORT, and what to do
# if it does not. A published port with nothing listening is the worst outcome:
# an SSH tunnel to it connects and then returns nothing, while llama-server is
# fine on PORT. With GATEWAY_FALLBACK=1 the entrypoint stops nginx and lets
# llama-server bind LISTEN_PORT directly, so the port you forward always serves
# the API (you lose /manage/ until the gateway is fixed). 0 fails loudly instead.
GATEWAY_WAIT=10
GATEWAY_FALLBACK=1

# --- Front door (nginx + njs) ----------------------------------------------
# nginx runs INSIDE this image, not beside it. It owns the published port 8080
# and proxies / to llama-server on 127.0.0.1:8081, while serving /manage/ itself.
# nginx starts first, so /manage/ answers through the whole first-run download.
#
# GATEWAY_ENABLE=0 turns the proxy off: then nothing serves /manage/ and you
# have to publish llama-server yourself with HOST=0.0.0.0 and PORT=8080.
# GATEWAY_ENABLE=1
#
# Empty disables the upload token entirely, which is the default: reaching the
# port already means an SSH tunnel, so a second secret buys little. Set it and
# uploads need X-Upload-Token (the /manage/ page has a field for it).
UPLOAD_TOKEN=

# Largest single upload nginx will accept. 0 = no limit.
MAX_UPLOAD_SIZE=8g

# --- Web search backend -----------------------------------------------------
# Only read when MCP_WEB_ENABLE=1. Empty = DuckDuckGo lite endpoint, no key and
# no account. Point at your own SearXNG to keep queries on your network (needs
# `json` in its search.formats).
SEARXNG_URL=
SEARCH_RESULTS=8
FETCH_MAX_CHARS=20000
HTTP_TIMEOUT=20
